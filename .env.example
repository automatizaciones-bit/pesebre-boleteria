# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...            # ¡secreta! sólo en el servidor / Vercel

# --- Seguridad ---
QR_SECRET=cambia-esto-por-una-frase-larga-y-aleatoria   # firma los QR. NO cambiar durante el evento
ACCESS_PASSWORD=clave-del-personal                      # clave para entrar a taquilla / portería / panel

# --- Evento ---
PRECIO_ADULTO=40000
PRECIO_NINO=20000
EVENTO_INICIO=2026-12-04
EVENTO_FIN=2027-01-03
# 1 = permite vender para HOY aunque esté fuera de las fechas del evento (para pruebas). Poner 0 en producción.
MODO_PRUEBA=1
